<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="incentive_order_wizard_view_form" model="ir.ui.view">
        <field name="name">incentive.order.wizard.form</field>
        <field name="model">incentive.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Incentive">
                <group>
                    <field name="purchase_order_id" force_save="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount"/>
                    <field name="note" placeholder="Reason for the incentive..."/>
                </group>
                <footer>
                    <button name="action_create_incentive" type="object"
                            string="Create" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
