<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_nt_truck" model="ir.ui.view">
        <field name="name">stock.picking.form.nt.truck</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']" position="before">
                <page string="Truck Details" name="nt_truck_details">
                    <field name="truck_locked" invisible="1"/>
                    <group>
                        <group>
                            <field name="vehicle_id"
                                   domain="[('company_id', 'in', [company_id, False])]"
                                   options="{'no_create': True}"
                                   readonly="truck_locked"/>
                            <field name="license_plate" readonly="truck_locked"/>
                        </group>
                        <group>
                            <field name="driver_id" readonly="truck_locked"/>
                            <field name="driver_phone" widget="phone"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="not truck_locked">
                        Truck details are locked because this transfer is done.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
