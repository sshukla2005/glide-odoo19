<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_nt_fixed_discount" model="ir.ui.view">
        <field name="name">sale.order.form.nt.fixed.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="fixed_discount_amount"
                       readonly="state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="before">
                <page string="Truck Details" name="nt_truck_details">
                    <field name="truck_locked" invisible="1"/>
                    <group>
                        <group>
                            <field name="purchase_order_id"
                                   domain="[('state', '=', 'purchase'), ('company_id', '=', company_id)]"
                                   options="{'no_create': True}"
                                   readonly="truck_locked"/>
                            <field name="vehicle_id"
                                   domain="[('company_id', 'in', [company_id, False])]"
                                   options="{'no_create': True}"
                                   readonly="truck_locked"/>
                            <field name="license_plate" readonly="truck_locked"/>
                        </group>
                        <group>
                            <field name="driver_id" readonly="truck_locked"/>
                            <field name="driver_phone" widget="phone"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="not truck_locked">
                        Truck details are locked because a delivery for this order is done.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
